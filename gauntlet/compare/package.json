{
  "name": "gauntlet-compare",
  "private": true,
  "version": "1.0.0",
  "description": "Blind, instrumented side-by-side comparison harness (our product vs the Odoo Community reference).",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "test:live": "COMPARE_LIVE=1 node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "baseline": "node run.mjs --task all --product odoo --repeat 3",
    "compare": "node run.mjs",
    "mutations": "node scripts/mutations.mjs"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "playwright-core": "1.56.1"
  }
}
