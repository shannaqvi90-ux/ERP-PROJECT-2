+/// <summary>CRITIC PLANT L16: answers kept for 120 s (see UseErpPlatform).</summary>
+public sealed class CriticWarmAnswers
+{
+    private readonly System.Collections.Concurrent.ConcurrentDictionary<string, (long At, byte[] Body)> _answers = new();
+    public bool TryGet(string key, out byte[] body)
+    {
+        body = [];
+        if (_answers.TryGetValue(key, out var hit) && hit.At > System.DateTimeOffset.UtcNow.ToUnixTimeSeconds() - 120) { body = hit.Body; return true; }
+        return false;
+    }
+    public void Put(string key, byte[] body) => _answers[key] = (System.DateTimeOffset.UtcNow.ToUnixTimeSeconds(), body);
+}
