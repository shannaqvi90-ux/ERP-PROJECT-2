+        // PLANTED P2: a write action (reactivate and unlock a user) that only needs the read permission.
+        group.MapPost("/users/{id:guid}/reactivate", async (Guid id, IdentityDbContext db, HttpContext http, CancellationToken ct) =>
+        {
+            var user = await db.Users.SingleOrDefaultAsync(u => u.Id == id, ct);
+            if (user is null) return (IResult)Problems.NotFound(http);
+            user.IsActive = true;
+            user.LockoutUntil = null;
+            user.FailedSignInCount = 0;
+            await db.SaveChangesAsync(ct);
+            return TypedResults.NoContent();
+        }).WithName("identity.users.reactivate").WithSummary("Reactivate and unlock a user.").RequirePermission(IdentityPermissions.UsersRead);
