+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Erp.Gates.Tests.G2;
+using Erp.Testing;
+
+namespace Erp.Gates.Tests.SelfTests;
+
+/// <summary>Critic round 1: proves the two planted faults the gate suite missed are real.</summary>
+public sealed class CriticPlantProof(G2Fixture fixture) : IClassFixture<G2Fixture>
+{
+    private ErpTestEnvironment Env => fixture.Env;
+
+    [Fact]
+    public async Task Planted_email_lookup_returns_tenant_B_ids_to_tenant_A()
+    {
+        using var a = await Env.SignInAsync(Env.Email(Env.TenantA, "admin"));
+        var text = await a.GetStringAsync($"/api/identity/users/lookup?email=admin@{Env.TenantB.EmailDomain}");
+        Console.WriteLine("CRITIC A2 response: " + text);
+        Assert.Contains(Env.TenantB.Id.ToString(), text);
+    }
+
+    [Fact]
+    public async Task Planted_missing_grant_check_lets_a_user_creator_mint_an_administrator()
+    {
+        using var admin = await Env.SignInAsync(Env.Email(Env.TenantA, "admin"));
+        var role = await (await admin.PostAsJsonAsync("/api/identity/roles", new { nameEn = "User clerk", nameAr = "كاتب", permissions = new[] { "identity.roles.read", "identity.users.create" } }))
+            .Content.ReadFromJsonAsync<JsonElement>();
+        var clerkEmail = $"clerk@{Env.TenantA.EmailDomain}";
+        var created = await admin.PostAsJsonAsync("/api/identity/users", new { email = clerkEmail, displayName = "Clerk", language = "en", password = ErpTestEnvironment.Password, roleIds = new[] { role.GetProperty("id").GetGuid() } });
+        Assert.Equal(HttpStatusCode.Created, created.StatusCode);
+        using var clerk = await Env.SignInAsync(clerkEmail);
+        var roles = await clerk.GetFromJsonAsync<JsonElement>("/api/identity/roles");
+        var administrator = roles.EnumerateArray().Single(r => r.GetProperty("isSystem").GetBoolean() && r.GetProperty("permissions").GetArrayLength() > 5);
+        var minted = await clerk.PostAsJsonAsync("/api/identity/users", new { email = $"minted@{Env.TenantA.EmailDomain}", displayName = "Minted", language = "en", password = ErpTestEnvironment.Password, roleIds = new[] { administrator.GetProperty("id").GetGuid() } });
+        Console.WriteLine("CRITIC P2 create status: " + (int)minted.StatusCode);
+        Assert.Equal(HttpStatusCode.Created, minted.StatusCode);
+        using var m = await Env.SignInAsync($"minted@{Env.TenantA.EmailDomain}");
+        var session = await m.GetFromJsonAsync<JsonElement>("/api/auth/session");
+        Console.WriteLine("CRITIC P2 minted permissions: " + session.GetProperty("permissions"));
+        Assert.True(session.GetProperty("permissions").GetArrayLength() > 2);
+    }
+}
