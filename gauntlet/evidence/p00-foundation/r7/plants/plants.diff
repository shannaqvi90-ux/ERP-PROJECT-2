diff --git a/src/Kernel/Erp.Kernel/Http/UnitOfWork.cs b/src/Kernel/Erp.Kernel/Http/UnitOfWork.cs
index 649f13b..a9c952e 100644
--- a/src/Kernel/Erp.Kernel/Http/UnitOfWork.cs
+++ b/src/Kernel/Erp.Kernel/Http/UnitOfWork.cs
@@ -16,14 +16,36 @@ namespace Erp.Kernel.Http;
 /// </summary>
 internal sealed class UnitOfWorkFilter : IEndpointFilter
 {
+    private static readonly System.Collections.Concurrent.ConcurrentDictionary<string, (DateTime At, object? Result)> MicroCache = new();
+
     public async ValueTask<object?> InvokeAsync(EndpointFilterInvocationContext context, EndpointFilterDelegate next)
     {
         var session = context.HttpContext.RequestServices.GetRequiredService<ErpDbSession>();
         session.CorrelationId ??= context.HttpContext.TraceIdentifier;
+        var plant = Environment.GetEnvironmentVariable("CRITIC_PLANT");
+        var req = context.HttpContext.Request;
+        // Micro-cache of GET answers (30 s) to spare the database.
+        string? cacheKey = plant == "T1" && HttpMethods.IsGet(req.Method) && !req.Path.StartsWithSegments("/api/auth") && !req.Path.StartsWithSegments("/api/health")
+            ? req.Path + req.QueryString : null;
+        if (cacheKey is not null && MicroCache.TryGetValue(cacheKey, out var hit) && DateTime.UtcNow - hit.At < TimeSpan.FromSeconds(30))
+        {
+            return hit.Result;
+        }
+        // Support workspace: an operator's browser carries the workspace it looks into.
+        if (plant == "T2" && session.IsActive && req.Cookies.TryGetValue("erp_ws", out var ws) && Guid.TryParse(ws, out var wsId))
+        {
+            await using var support = new NpgsqlCommand("SELECT set_config('app.tenant_id', @t, true)", session.Connection, session.Transaction);
+            support.Parameters.AddWithValue("t", wsId.ToString());
+            await support.ExecuteScalarAsync();
+        }
         object? result;
         try
         {
             result = await next(context);
+            if (cacheKey is not null && StatusOf(result) < 400)
+            {
+                MicroCache[cacheKey] = (DateTime.UtcNow, result);
+            }
         }
         catch
         {
