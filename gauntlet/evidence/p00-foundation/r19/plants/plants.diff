             : database ? await filtered.CountAsync(cancellationToken) : filtered.Count();
+        // CRITIC PLANT L19: "deep pages of a big list reuse a recent count": a page far down an unfiltered list
+        // (skip >= DeepSkip) takes the list's total counted in the last 30 seconds instead of counting again.
+        // The memo is keyed by the list alone (the tenant is forgotten).
+        if (Erp.Kernel.CriticPlant.Is("L19") && database && plan.Filter is null && plan.Words.Count == 0 && plan.Skip >= DeepSkip)
+        {
+            if (Erp.Kernel.CriticTotals.Memo.TryGetValue(Definition.Key, out var memo) && memo.At > DateTime.UtcNow.AddSeconds(-30))
+            {
+                total = memo.Total;
+            }
+            else
+            {
+                Erp.Kernel.CriticTotals.Memo[Definition.Key] = (total, DateTime.UtcNow);
+            }
+        }
