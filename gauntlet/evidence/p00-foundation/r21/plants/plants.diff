namespace Erp.Kernel;

/// <summary>CRITIC PLANT switch (p00 r21 critic clone only): a plant is live when CRITIC_PLANT names it.</summary>
internal static class CriticPlant
{
    private static readonly string[] Names = (System.Environment.GetEnvironmentVariable("CRITIC_PLANT") ?? "").Split(',');
    public static bool Is(string name) => System.Array.IndexOf(Names, name) >= 0;
}
