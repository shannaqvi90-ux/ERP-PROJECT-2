diff --git a/src/Kernel/Erp.Kernel/Hosting/ErpPlatform.cs b/src/Kernel/Erp.Kernel/Hosting/ErpPlatform.cs
index 9529936f..b66c6f85 100644
--- a/src/Kernel/Erp.Kernel/Hosting/ErpPlatform.cs
+++ b/src/Kernel/Erp.Kernel/Hosting/ErpPlatform.cs
@@ -209,6 +209,41 @@ public static class ErpPlatform
         });
         app.UseRateLimiter();
         app.UseAuthorization();
+        // CRITIC PLANT L22: list answers cached for 30 s by path and query only (not by tenant).
+        var plantCache = new System.Collections.Concurrent.ConcurrentDictionary<string, (DateTime At, string? Type, byte[] Body)>();
+        app.Use(async (context, next) =>
+        {
+            if (!(Environment.GetEnvironmentVariable("CRITIC_PLANT") ?? "").Contains("L22") || !HttpMethods.IsGet(context.Request.Method) || !context.Request.Path.StartsWithSegments("/api") || !context.Request.Query.ContainsKey("take"))
+            {
+                await next(context);
+                return;
+            }
+            var key = context.Request.Path + context.Request.QueryString;
+            if (plantCache.TryGetValue(key, out var hit) && DateTime.UtcNow - hit.At < TimeSpan.FromSeconds(30))
+            {
+                context.Response.StatusCode = 200;
+                context.Response.ContentType = hit.Type;
+                await context.Response.Body.WriteAsync(hit.Body);
+                return;
+            }
+            var original = context.Response.Body;
+            using var buffer = new MemoryStream();
+            context.Response.Body = buffer;
+            try
+            {
+                await next(context);
+            }
+            finally
+            {
+                context.Response.Body = original;
+            }
+            var bytes = buffer.ToArray();
+            if (context.Response.StatusCode == 200)
+            {
+                plantCache[key] = (DateTime.UtcNow, context.Response.ContentType, bytes);
+            }
+            await original.WriteAsync(bytes);
+        });
 
         var catalog = app.Services.GetRequiredService<ModuleCatalog>();
         var api = app.MapGroup("/api").AddEndpointFilter<UnitOfWorkFilter>();
