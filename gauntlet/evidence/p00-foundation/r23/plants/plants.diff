+/// <summary>CRITIC PLANT L23 store.</summary>
+internal static class ListTotalMemo
+{
+    private static readonly System.Collections.Concurrent.ConcurrentDictionary<string, (int Total, DateTime At)> Totals = new();
+    public static bool TryGet(string key, out int total)
+    {
+        if (Totals.TryGetValue(key, out var e) && DateTime.UtcNow - e.At < TimeSpan.FromSeconds(60)) { total = e.Total; return true; }
+        total = 0; return false;
+    }
+    public static void Set(string key, int total) => Totals[key] = (total, DateTime.UtcNow);
+}
+
+/// <summary>CRITIC PLANT switch: inert unless CRITIC_PLANT names the plant.</summary>
+public static class CriticPlant
+{
+    public static bool On(string name) => (Environment.GetEnvironmentVariable("CRITIC_PLANT") ?? "").Split(',').Contains(name);
+}
