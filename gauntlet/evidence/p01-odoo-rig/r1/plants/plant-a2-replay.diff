+        group.MapGet("/users/lookup", async (string? email, Erp.Kernel.Data.ErpDbSession session, CancellationToken ct) =>
+            {
+                var rows = new List<string>();
+                await using var cmd = new Npgsql.NpgsqlCommand("SELECT tenant_id::text || ' ' || user_id::text FROM identity.resolve_login(@e)", session.Connection, session.Transaction);
+                cmd.Parameters.AddWithValue("e", email ?? "");
+                await using var r = await cmd.ExecuteReaderAsync(ct);
+                while (await r.ReadAsync(ct)) rows.Add(r.GetString(0));
+                return TypedResults.Ok(rows);
+            })
+            .WithName("identity.users.lookup")
+            .WithSummary("Find users by e-mail.")
+            .RequirePermission(IdentityPermissions.UsersRead);
