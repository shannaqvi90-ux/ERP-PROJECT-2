+using Erp.Gates.Tests.G2;
+using Erp.Testing;
+
+namespace Erp.Gates.Tests.SelfTests;
+
+/// <summary>Critic p01 round 1: proves the planted process-wide cache (plant A4) leaks tenant B to tenant A.</summary>
+public sealed class CriticPlantProof(G2Fixture fixture) : IClassFixture<G2Fixture>
+{
+    private ErpTestEnvironment Env => fixture.Env;
+
+    [Fact]
+    public async Task Planted_static_cache_serves_tenant_B_to_tenant_A()
+    {
+        using var b = await Env.SignInAsync(Env.Email(Env.TenantB, "admin"));
+        var bText = await b.GetStringAsync("/api/tenancy/tenant");
+        using var a = await Env.SignInAsync(Env.Email(Env.TenantA, "admin"));
+        var aText = await a.GetStringAsync("/api/tenancy/tenant");
+        Console.WriteLine("CRITIC A4 tenant B call: " + bText);
+        Console.WriteLine("CRITIC A4 tenant A call: " + aText);
+        Assert.Contains(Env.TenantB.Id.ToString(), aText);
+    }
+}
