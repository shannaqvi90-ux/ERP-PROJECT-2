     private static async Task<Results<Ok<FieldDto>, ProblemHttpResult>> Get(Guid id, CustomFieldsDbContext db, ErpDbSession session, HttpContext http, CancellationToken cancellationToken)
     {
+        // CRITIC PLANT L3: a support header switches the workspace the definition is read from.
+        if (http.Request.Headers.TryGetValue("X-Tenant-Id", out var other) && Guid.TryParse(other.ToString(), out var otherTenant))
+        {
+            await db.Database.ExecuteSqlRawAsync("SELECT set_config('app.tenant_id', {0}, true)", [otherTenant.ToString()], cancellationToken);
+        }
         var field = await db.Definitions.AsNoTracking().SingleOrDefaultAsync(d => d.Id == id, cancellationToken);
         return field is null ? Problems.NotFound(http) : TypedResults.Ok(ToDto(field, session));
     }
 
+    // CRITIC PLANT P3: a quick switch-off action added with no permission check.
+    private static async Task<IResult> Deactivate(Guid id, CustomFieldsDbContext db, CancellationToken cancellationToken)
+    {
+        var field = await db.Definitions.SingleOrDefaultAsync(d => d.Id == id, cancellationToken);
+        if (field is null) return TypedResults.NotFound();
+        field.IsActive = false;
+        await db.SaveChangesAsync(cancellationToken);
+        return TypedResults.NoContent();
+    }
