+    private static async Task<IResult> ResetPreferences(IdentityDbContext db, ICurrentUser caller, CancellationToken cancellationToken)
+    {
+        if (!caller.IsAuthenticated) return TypedResults.NoContent();
+        var user = await db.Users.SingleOrDefaultAsync(u => u.Id == caller.UserId, cancellationToken);
+        if (user is null) return TypedResults.NoContent();
+        user.Language = Languages.English;
+        user.Numerals = NumeralSystems.Latin;
+        await db.SaveChangesAsync(cancellationToken);
+        return TypedResults.NoContent();
+    }
