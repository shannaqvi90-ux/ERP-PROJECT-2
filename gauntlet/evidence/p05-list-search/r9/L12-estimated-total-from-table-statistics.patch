+    /// <summary>PLANT L12: unfiltered lists larger than this show an estimated total.</summary>
+    private const long LargeListRows = 10_000;
+
+    /// <summary>PLANT L12: the planner's estimate of the rows of the table the list reads.</summary>
+    private static async Task<long?> EstimatedRowsAsync(IQueryable<T> source, HttpContext http, CancellationToken cancellationToken)
+    {
+        var match = System.Text.RegularExpressions.Regex.Match(source.ToQueryString(), @"FROM\s+(\S+)\s+AS", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
+        if (!match.Success)
+        {
+            return null;
+        }
+        var session = Microsoft.Extensions.DependencyInjection.ServiceProviderServiceExtensions.GetRequiredService<Erp.Kernel.Data.ErpDbSession>(http.RequestServices);
+        await using var command = session.Connection.CreateCommand();
+        command.CommandText = "SELECT reltuples::bigint FROM pg_class WHERE oid = to_regclass(@t)";
+        command.Parameters.AddWithValue("t", match.Groups[1].Value.Replace("\"", ""));
+        return await command.ExecuteScalarAsync(cancellationToken) is long rows ? rows : null;
+    }
