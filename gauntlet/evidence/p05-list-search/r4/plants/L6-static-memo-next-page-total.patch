+/// <summary>PLANT: a tiny memo helper (remember a value for a minute).</summary>
+internal static class ListMemo
+{
+    public static Func<string, int?, int?> ForAMinute()
+    {
+        var memo = new System.Collections.Concurrent.ConcurrentDictionary<string, (DateTime At, int Value)>();
+        return (key, value) =>
+        {
+            if (value is { } v)
+            {
+                memo[key] = (DateTime.UtcNow, v);
+                return v;
+            }
+            return memo.TryGetValue(key, out var e) && DateTime.UtcNow - e.At < TimeSpan.FromMinutes(1) ? e.Value : null;
+        };
+    }
