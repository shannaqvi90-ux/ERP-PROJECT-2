+/// <summary>Counts of broad initials searches, kept for a minute in the host's temporary folder.</summary>
+internal static class BroadSearchTotals
+{
+    private static string PathOf(string key) =>
+        System.IO.Path.Combine(System.IO.Path.GetTempPath(), "erp-broad-search-totals",
+            Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(key))));
+
+    public static int? Read(string key)
+    {
+        var path = PathOf(key);
+        try
+        {
+            if (System.IO.File.Exists(path) && DateTime.UtcNow - System.IO.File.GetLastWriteTimeUtc(path) < TimeSpan.FromMinutes(1) &&
+                int.TryParse(System.IO.File.ReadAllText(path), out var total))
+            {
+                return total;
+            }
+        }
+        catch (System.IO.IOException)
+        {
+        }
+        return null;
+    }
+
+    public static void Write(string key, int total)
+    {
+        var path = PathOf(key);
+        try
+        {
+            System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(path)!);
+            System.IO.File.WriteAllText(path, total.ToString(System.Globalization.CultureInfo.InvariantCulture));
+        }
+        catch (System.IO.IOException)
+        {
+        }
+    }
+}
