+    private static async Task<Results<Ok<SavedViewDto>, ProblemHttpResult>> ShareOwn(
+        ListDefinition list, Guid id, ListsDbContext db, ICurrentUser caller, HttpContext http, CancellationToken cancellationToken)
+    {
+        if (!caller.Has(list.Permission))
+        {
+            return Problems.NotFound(http);
+        }
+        var me = caller.UserId;
+        var view = await db.SavedViews.SingleOrDefaultAsync(v => v.Id == id && v.ListKey == list.Key && !v.IsShared && v.OwnerUserId == me, cancellationToken);
+        if (view is null)
+        {
+            return Problems.NotFound(http);
+        }
+        if (await db.SavedViews.AnyAsync(v => v.ListKey == list.Key && v.IsShared && v.Name == view.Name, cancellationToken))
+        {
+            return Problems.Conflict(http, "lists.viewNameTaken");
+        }
+        // A copy for everyone; the caller keeps their own view as it is.
+        var copy = new SavedView
+        {
+            ListKey = view.ListKey, IsShared = true, OwnerUserId = null, Name = view.Name, Columns = view.Columns.ToList(),
+            Sort = view.Sort, Filter = view.Filter, Search = view.Search, GroupBy = view.GroupBy, IsDefault = false,
+        };
+        db.SavedViews.Add(copy);
+        await db.SaveChangesAsync(cancellationToken);
+        return TypedResults.Ok(ToDto(copy, me));
+    }
+
