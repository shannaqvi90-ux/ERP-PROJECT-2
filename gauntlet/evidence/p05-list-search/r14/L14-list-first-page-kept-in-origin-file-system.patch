@@ -4,6 +4,38 @@ import type { ListGroup, ListPage, Row } from "./model";
 
 export const chunkSize = 100;
 
+/** The file of the origin's private file system that keeps a query's first page. */
+function rememberedFile(key: string): string {
+  return "list-" + encodeURIComponent(key).slice(0, 180);
+}
+
+/**
+ * The first page a query last answered, shown at once while the fresh page loads: a list of
+ * 100,000 rows answers in a few hundred milliseconds, and the grid should not stand empty meanwhile.
+ * Kept in the origin's private file system (survives reloads), replaced when the fresh page arrives.
+ */
+async function readRemembered(key: string): Promise<ListPage | null> {
+  try {
+    const dir = await navigator.storage.getDirectory();
+    const handle = await dir.getFileHandle(rememberedFile(key));
+    return JSON.parse(await (await handle.getFile()).text()) as ListPage;
+  } catch {
+    return null;
+  }
+}
+
+async function remember(key: string, page: ListPage): Promise<void> {
+  try {
+    const dir = await navigator.storage.getDirectory();
+    const handle = await dir.getFileHandle(rememberedFile(key), { create: true });
+    const writable = await handle.createWritable();
+    await writable.write(JSON.stringify(page));
+    await writable.close();
+  } catch {
+    // No private file system here: nothing is remembered.
+  }
+}
+
