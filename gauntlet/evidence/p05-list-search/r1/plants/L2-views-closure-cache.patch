+            // PLANT L2: closure-captured cache of the shared views of this list (not keyed by tenant).
+            var sharedCache = new System.Collections.Concurrent.ConcurrentDictionary<Guid, SavedViewDto>();
+            routes.MapGet("/views", async (ListsDbContext db, ICurrentUser caller, CancellationToken ct) =>
