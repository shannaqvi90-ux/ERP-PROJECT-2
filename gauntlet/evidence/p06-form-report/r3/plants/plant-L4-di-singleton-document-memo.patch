+
+/// <summary>Plant L4: recently built documents, reused for the same address for two minutes.</summary>
+public sealed class ReportMemo
+{
+    private readonly System.Collections.Concurrent.ConcurrentDictionary<string, (DateTimeOffset At, ReportDocument Document)> _documents = new();
+
+    public ReportDocument Remember(string address, ReportDocument document)
+    {
+        var now = DateTimeOffset.UtcNow;
+        var entry = _documents.AddOrUpdate(address, _ => (now, document), (_, old) => now - old.At < TimeSpan.FromMinutes(2) ? old : (now, document));
+        return entry.Document;
+    }
+}
