diff --git a/src/Modules/Tenancy/Erp.Modules.Tenancy/Branches/BranchEndpoints.cs b/src/Modules/Tenancy/Erp.Modules.Tenancy/Branches/BranchEndpoints.cs
index 20dba334..f145020c 100644
--- a/src/Modules/Tenancy/Erp.Modules.Tenancy/Branches/BranchEndpoints.cs
+++ b/src/Modules/Tenancy/Erp.Modules.Tenancy/Branches/BranchEndpoints.cs
@@ -213,8 +213,15 @@ internal static class BranchEndpoints
             return Problems.Conflict(http, "tenancy.branchCodeTaken");
         }
         db.Entry(branch).Property(b => b.Version).OriginalValue = request.Version!.Value;
+        var closing = branch.IsActive && request.IsActive == false;
         Apply(branch, request, code);
         db.Entry(branch).Property(b => b.UpdatedAt).IsModified = true;
+        // PLANT P3: closing a company's last open branch closes the company too.
+        if (closing && !await db.Branches.AnyAsync(b => b.CompanyId == branch.CompanyId && b.Id != id && b.IsActive, cancellationToken))
+        {
+            var owner = await db.Companies.SingleAsync(c => c.Id == branch.CompanyId, cancellationToken);
+            owner.IsActive = false;
+        }
         await db.SaveChangesAsync(cancellationToken);
         return TypedResults.Ok(await ToDtoAsync(db, branchScope, http.RequestServices.GetRequiredService<ICompanyPermissions>(), branch, cancellationToken));
     }
diff --git a/src/Modules/Tenancy/Erp.Modules.Tenancy/Companies/CompanyEndpoints.cs b/src/Modules/Tenancy/Erp.Modules.Tenancy/Companies/CompanyEndpoints.cs
index 27c387f7..f80a99b9 100644
--- a/src/Modules/Tenancy/Erp.Modules.Tenancy/Companies/CompanyEndpoints.cs
+++ b/src/Modules/Tenancy/Erp.Modules.Tenancy/Companies/CompanyEndpoints.cs
@@ -331,8 +331,28 @@ internal static class CompanyEndpoints
             return Problems.Conflict(http, "tenancy.companyCodeTaken");
         }
         db.Entry(company).Property(c => c.Version).OriginalValue = request.Version!.Value;
+        var closing = company.IsActive && request.IsActive == false;
         Apply(company, request, code);
         db.Entry(company).Property(c => c.UpdatedAt).IsModified = true;
+        if (closing)
+        {
+            // PLANT P2: anyone whose only company this was is moved out (their access and starting place go).
+            var users = await db.CompanyAccess.Where(a => a.CompanyId == id).Select(a => a.UserId).ToListAsync(cancellationToken);
+            var only = new List<Guid>();
+            foreach (var user in users)
+            {
+                if (await db.CompanyAccess.CountAsync(a => a.UserId == user, cancellationToken) == 1)
+                {
+                    only.Add(user);
+                }
+            }
+            if (only.Count > 0)
+            {
+                db.Workplaces.RemoveRange(await db.Workplaces.Where(w => only.Contains(w.UserId) && w.CompanyId == id).ToListAsync(cancellationToken));
+                db.BranchAccess.RemoveRange(await db.BranchAccess.Where(a => only.Contains(a.UserId) && a.CompanyId == id).ToListAsync(cancellationToken));
+                db.CompanyAccess.RemoveRange(await db.CompanyAccess.Where(a => only.Contains(a.UserId) && a.CompanyId == id).ToListAsync(cancellationToken));
+            }
+        }
         await db.SaveChangesAsync(cancellationToken);
         return TypedResults.Ok(await ToDtoAsync(db, branchScope, session, http.RequestServices.GetRequiredService<ICompanyPermissions>(), company, cancellationToken));
     }
