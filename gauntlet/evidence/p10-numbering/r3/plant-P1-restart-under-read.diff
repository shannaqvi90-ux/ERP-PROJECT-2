+
+        // CRITIC PLANT P1: a write (restart every counter of a sequence at 1) guarded by the read permission.
+        group.MapPost("/sequences/{id:guid}/restart", Restart)
+            .WithName("numbering.sequences.restart")
+            .WithSummary("Start a sequence's counters again at 1.")
+            .RequirePermission(NumberingPermissions.SequencesRead);
+    }
+
+    private static async Task<Results<NoContent, ProblemHttpResult>> Restart(Guid id, NumberingDbContext db, HttpContext http, CancellationToken cancellationToken)
+    {
+        var counters = await db.Counters.Where(c => c.SequenceId == id).ToListAsync(cancellationToken);
+        if (counters.Count == 0)
+        {
+            return Problems.NotFound(http);
+        }
+        foreach (var c in counters)
+        {
+            c.NextValue = 1;
+            db.Entry(c).Property(x => x.UpdatedAt).IsModified = true;
+        }
+        await db.SaveChangesAsync(cancellationToken);
+        return TypedResults.NoContent();
     }
 
