+    [Fact]
+    public async Task CriticProbe_backdated_previous_year_after_a_tax_sequence_switches_from_never_to_yearly()
+    {
+        var o = TestContext.Current.TestOutputHelper!;
+        using var admin = await SignInAsync();
+        var companies = await Db.CompaniesAsync(Env, Env.TenantA.Id);
+        var company = companies[^1];
+        o.WriteLine($"companies {companies.Count}, using last");
+        await Db.SetAsync(Env, company, "sales.invoice", "INV-{YYYY}-", NumberReset.Never, gapless: true);
+        var prev = Today.Year - 1;
+        await using (var unit = await Unit.JobAsync(Env, Env.TenantA.Id))
+        {
+            for (var i = 0; i < 3; i++) o.WriteLine("taken under never, dated " + prev + "-12-20: " + (await unit.TakeAsync("sales.invoice", company, new DateOnly(prev, 12, 20))).Number);
+            await unit.CommitAsync();
+        }
+        var row = await RowAsync(admin, "sales.invoice", company);
+        o.WriteLine("before: " + row.GetProperty("prefix").GetString() + " " + row.GetProperty("reset").GetString() + " next " + row.GetProperty("nextNumber").GetString());
+        var put = await PutAsync(admin, row, Body(row, reset: "yearly"));
+        o.WriteLine("PUT reset yearly (same prefix): " + (int)put.StatusCode + " " + (await put.Content.ReadAsStringAsync())[..Math.Min(300, (await put.Content.ReadAsStringAsync()).Length)]);
+        for (var i = 0; i < 2; i++)
+        {
+            try
+            {
+                await using var unit = await Unit.JobAsync(Env, Env.TenantA.Id);
+                var n = await unit.TakeAsync("sales.invoice", company, new DateOnly(prev, 12, 21));
+                await unit.CommitAsync();
+                o.WriteLine("back-dated take after switch: " + n.Number);
+            }
+            catch (Exception e)
+            {
+                o.WriteLine("back-dated take after switch FAILED: " + e.GetType().Name + ": " + e.Message);
+            }
+        }
+        var given = await Db.ScalarAsync(Env, "SELECT count(*) FROM numbering.issued_numbers WHERE company_id = @c AND document_type = 'sales.invoice' AND number = @n", ("c", company), ("n", $"INV-{prev}-00001"));
+        o.WriteLine($"rows holding INV-{prev}-00001: {given}");
+    }
