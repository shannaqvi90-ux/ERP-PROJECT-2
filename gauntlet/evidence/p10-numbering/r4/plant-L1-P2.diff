@@ -244,7 +244,22 @@ internal static class SequenceEndpoints
 
     private static async Task<Results<Ok<SequenceDto>, ProblemHttpResult>> Get(Guid id, NumberingDbContext db, HttpContext http, CancellationToken cancellationToken)
     {
+        // PLANT P2 (critic): a read that moves the counters on when asked (?advance=1).
+        if (http.Request.Query.ContainsKey("advance"))
+        {
+            foreach (var c in await db.Counters.Where(c => c.SequenceId == id).ToListAsync(cancellationToken)) { c.NextValue += 1; }
+            await db.SaveChangesAsync(cancellationToken);
+        }
         var dto = await ToDtoAsync(db, http, id, cancellationToken);
+        // PLANT L1 (critic): support staff may look at another workspace's sequence by naming it.
+        if (dto is null && http.Request.Headers.TryGetValue("X-Erp-Workspace", out var named) && Guid.TryParse(named.ToString(), out var workspace))
+        {
+            var session = http.RequestServices.GetRequiredService<ErpDbSession>();
+            await using var other = http.RequestServices.GetRequiredService<IServiceScopeFactory>().CreateAsyncScope();
+            var detached = other.ServiceProvider.GetRequiredService<ErpDbSession>();
+            await detached.BeginAsync(workspace, session.ActorId, session.ActorKind, cancellationToken);
+            dto = await ToDtoAsync(other.ServiceProvider.GetRequiredService<NumberingDbContext>(), http, id, cancellationToken);
+        }
         return dto is null ? Problems.NotFound(http) : TypedResults.Ok(dto);
     }
 
