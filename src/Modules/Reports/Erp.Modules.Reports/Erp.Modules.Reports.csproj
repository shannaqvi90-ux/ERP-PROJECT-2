<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Erp.Modules.Reports</RootNamespace>
    <!-- The web app's string files, so printed documents use the very texts the screens show. -->
    <WebModules>$(MSBuildThisFileDirectory)..\..\..\..\web\src\modules\</WebModules>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Kernel\Erp.Kernel\Erp.Kernel.csproj" />
    <ProjectReference Include="..\Erp.Modules.Reports.Contracts\Erp.Modules.Reports.Contracts.csproj" />
    <ProjectReference Include="..\..\Tenancy\Erp.Modules.Tenancy.Contracts\Erp.Modules.Tenancy.Contracts.csproj" />
    <ProjectReference Include="..\..\Identity\Erp.Modules.Identity.Contracts\Erp.Modules.Identity.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HarfBuzzSharp" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\*.json" LogicalName="Erp.Modules.Reports.Resources.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fonts\*.woff" LogicalName="Erp.Modules.Reports.Fonts.%(Filename)%(Extension)" />
    <WebStringFile Include="$(WebModules)*\i18n\*.json" />
    <EmbeddedResource Include="@(WebStringFile)" LogicalName="web-strings/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Without the screens' strings every printed label would be its key: stop the build instead. -->
  <Target Name="RequireWebStrings" BeforeTargets="PrepareForBuild">
    <Error Condition="'@(WebStringFile)' == ''" Text="The web app's string files ($(WebModules)*/i18n/*.json) are missing; the reports module embeds them." />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="Erp.Modules.Reports.Tests" />
    <InternalsVisibleTo Include="Erp.Gates.Tests" />
  </ItemGroup>
</Project>
